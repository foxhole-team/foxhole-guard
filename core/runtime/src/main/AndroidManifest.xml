<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The runtime reads network state via ConnectivityManager; declaring it here keeps the
         library's own lint honest and merges harmlessly into the app (which also declares it). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
