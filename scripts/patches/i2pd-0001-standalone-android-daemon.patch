+			  << "transit_tunnels=" << i2p::tunnel::tunnels.CountTransitTunnels () << "\n"
+			  << "received_bytes=" << i2p::transport::transports.GetTotalReceivedBytes () << "\n"
+			  << "sent_bytes=" << i2p::transport::transports.GetTotalSentBytes () << "\n"
+			  << "transit_bytes=" << i2p::transport::transports.GetTotalTransitTransmittedBytes () << "\n"
+			  << "received_bytes_per_sec=" << i2p::transport::transports.GetInBandwidth15s () << "\n"
+			  << "sent_bytes_per_sec=" << i2p::transport::transports.GetOutBandwidth15s () << "\n"
+			  << "transit_bytes_per_sec=" << i2p::transport::transports.GetTransitBandwidth15s () << "\n"
+			  << "version=" VERSION "\n";
+			res.code = 200;
+			content = s.str ();
+			SendReply (res, content);
+			return;
+		}
